html 
    head
        title Create user 
        link(rel="stylesheet", href="/styles.css")
    body 
        div(class="wrapper-center")
            h1 Create new user 
            form(action="/users" method="POST" class="userform")
                div
                    label(for="username") username
                    input(name="username")
                div
                    label(for="password") password
                    input(name="password")
                div 
                    select(name="level" )
                        option(value="1") 1
                        option(value="2") 2
                        option(value="3") 3
                
                button(type="submit") create user