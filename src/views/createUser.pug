html 
    head
        title Create user 
        link(rel="stylesheet", href="/styles.css")
    body 
        div(class="wrapper-center")
            h1 Create new user 
            form(action="/users" method="POST" class="userform")
                div
                    label(for="username") Brugernavn
                    input(type="text" name="username" id="username" required)
                div
                    label(for="password") Password
                    input(type="password" name="password" id="password" required)
                div 
                    label(for="level") Brugerniveau
                    select(name="level" id="level" required)
                        option(value="1") 1 - Bruger
                        option(value="2") 2 - Chatadministrator
                        option(value="3") 3 - Administrator

                button(type="submit") Opret bruger