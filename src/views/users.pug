html
    head
        title Users
        link(rel="stylesheet", href="/styles.css")
    body(class="wrapper-center")
        a(href="/chats") ← Tilbage
        h1 Administrer brugere
        a(href="/users/create") Opret ny bruger
        table(class="users-table")
            thead
                tr
                    th Id
                    th Username
                    th Level
                    th Oprettet
                    th Online
                    th
            tbody
                each u in users
                    tr(data-userid=u.userid)
                        td= u.userid
                        td= u.username
                        td= u.level
                        td= new Date().toDateString()
                        td= u.isActive ? "🟢" : "🔴"
                        td
                            button(class="deleteBtn") Slet