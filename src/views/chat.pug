html
    head
        title= chat.name
        link(rel="stylesheet", href="/styles.css")
        script(src="/editChat.js" defer)
        script(src="/deleteChat.js" defer)
    body(class="wrapper-center")
        a(href="/chats") ← Tilbage
        h1 #{chat.name}

        if (user.userLevel == 3 || user.userLevel == 2 && chat.owner == user.userId)
            input(type="text" class="chatname" value=chat.name required)
            button(data-chatid=chat.id class="editchat") Gem navn
            button(class="deletechat" data-chatid=chat.id) Slet chat

        div(class="messages")
            if messages.length === 0
                p(class="empty") Ingen beskeder endnu
            each message in messages
                div(class="message "  + (user.userId == message.senderId ? "own" : "") )
                    span(class="author") #{message.username}
                    p #{message.message}

        form(class="messageForm" method="POST" action=`/chats/${chat.id}/messages`)
            input(type="text" name="message" placeholder="Skriv en besked..." required)
            button(type="submit") Send